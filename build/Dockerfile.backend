# Build stage
FROM rust:1.92-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY tgs-backend/Cargo.toml tgs-backend/Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release --no-default-features --features anthropic
RUN rm -f target/release/deps/tgs_backend*

COPY tgs-backend/src ./src
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/tgs-backend /usr/local/bin/tgs-backend

EXPOSE 8080

CMD ["tgs-backend"]